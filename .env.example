# .env.example — SÓ NOMES das variáveis. NUNCA pôr valores/chaves reais aqui.
# Copiar para .env e preencher no servidor (fora do controlo de versões).

# --- Ligação à base (role DEDICADO, NÃO service_role) ---
SUPABASE_DB_URL=

# --- Provedores de modelo, por ordem (do grátis ao caro) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Claude/Anthropic: PROIBIDO por omissão. ---
# Só é usado se ALLOW_CLAUDE=1 E ANTHROPIC_API_KEY existir.
ALLOW_CLAUDE=
ANTHROPIC_API_KEY=

# --- Ajustes opcionais (têm valores por omissão no código) ---
ROUTER_TIMEOUT_S=
ROUTER_BACKOFF_S=
COORD_HORAS_ARREFECER=
COPY_MAX_POR_CORRIDA=
